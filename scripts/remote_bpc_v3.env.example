# 复制为 remote_bpc_v3.env 并填写（该文件已 gitignore，勿提交仓库）
REMOTE_HOST=183.232.132.248
REMOTE_PORT=31407
REMOTE_USER=user
REMOTE_PASSWORD=

# 远程项目根目录（quant_cursor 包父目录）
REMOTE_PROJECT_ROOT=/home/user/pdl/mylab/quant

# v3 代码目录（相对 REMOTE_PROJECT_ROOT/quant_cursor/bpc_v3）
REMOTE_BPC_V3_DIR=/home/user/pdl/mylab/quant/quant_cursor/bpc_v3

# 远程 venv
REMOTE_VENV_ACTIVATE=source ~/pdl/venv/bin/activate

# 训练默认参数（4×48GB 可加大 batch）
REMOTE_CUDA_DEVICE=cuda:0
REMOTE_BATCH_SIZE=4096
